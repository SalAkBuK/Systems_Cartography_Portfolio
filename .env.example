# Optional contact form endpoint (for example, a Formspree endpoint).
# Leave empty to use the visitor's default email application instead.
VITE_CONTACT_FORM_ENDPOINT=

# Optional GitHub token for the runtime live-inventory endpoint (/api/github-live)
# and the setup-time snapshot sync. SERVER-SIDE ONLY: never prefix it with VITE_
# (that would inline it into client JavaScript). No scopes are needed for public
# repository data. Live sync also works with no token, subject to GitHub's
# unauthenticated rate limit.
#
# The live endpoint's GitHub owner is ALWAYS the committed
# OWNER_PROFILE.githubTarget -- there is no owner override, in any environment.
GITHUB_TOKEN=
