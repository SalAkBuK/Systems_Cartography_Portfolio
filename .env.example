# ===========================================================================
# Contact form delivery
# ===========================================================================

# PUBLIC browser configuration -- safe to expose (this is only an endpoint
# path, NOT a secret). Choose one:
#
#   /api/contact                -> the built-in first-party endpoint. This
#                                  deployment's own Vercel Node function
#                                  (api/contact.ts) delivers the message to the
#                                  owner via Resend. Needs the three server-only
#                                  values below.
#   https://formspree.io/f/<id> -> an external hosted form endpoint (template /
#                                  fork compatibility). Any safe absolute HTTPS
#                                  URL is accepted.
#   (leave empty)               -> no endpoint; the form opens the visitor's own
#                                  mail client (the default, safe behavior).
VITE_CONTACT_FORM_ENDPOINT=/api/contact

# SERVER-ONLY contact delivery configuration for the built-in /api/contact
# endpoint. NEVER prefix any of these with VITE_ -- a VITE_ variable is inlined
# into the client JavaScript bundle and visible in page source. These are read
# only by the server function; never bundled into browser code, never logged,
# never returned in a response.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
#
# Example values (do NOT commit real ones):
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   CONTACT_TO_EMAIL=owner@example.com
#   CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
#
# Testing note: onboarding@resend.dev is Resend's shared sandbox sender. It
# works for initial testing only while Resend restricts delivery to your own
# account email. For real use, verify a custom sending domain in the Resend
# dashboard and point CONTACT_FROM_EMAIL at an address on that domain -- no
# code change is needed.

# ===========================================================================
# Live GitHub inventory (/api/github-live) + setup-time snapshot sync
# ===========================================================================

# Optional GitHub token for the runtime live-inventory endpoint and the
# setup-time snapshot sync. SERVER-SIDE ONLY: never prefix it with VITE_ (that
# would inline it into client JavaScript). No scopes are needed for public
# repository data. Live sync also works with no token, subject to GitHub's
# unauthenticated rate limit.
#
# The live endpoint's GitHub owner is ALWAYS the committed
# OWNER_PROFILE.githubTarget -- there is no owner override, in any environment.
GITHUB_TOKEN=
